# Makefile generated by OpenModelica
# Platform: aarch64-linux

# Simulations use -O3 by default
CC=clang
CXX=clang++ -std=c++17
LINK=clang -shared
EXEEXT=
DLLEXT=.so
CFLAGS_BASED_ON_INIT_FILE=
# define OMC_CFLAGS_OPTIMIZATION env variable to your desired optimization level to override this
OMC_CFLAGS_OPTIMIZATION=-Os
DEBUG_FLAGS=$(OMC_CFLAGS_OPTIMIZATION)
CFLAGS= $(CFLAGS_BASED_ON_INIT_FILE) $(DEBUG_FLAGS) -DOM_HAVE_PTHREADS -fPIC -falign-functions -fno-dollars-in-identifiers -Wno-parentheses-equality ${MODELICAUSERCFLAGS}   
CPPFLAGS= -I"/usr/bin/../include/omc/c" -I"/usr/bin/../include/omc" -I. -DOPENMODELICA_XML_FROM_FILE_AT_RUNTIME -DOMC_MODEL_PREFIX=RideThroughCore -DOMC_NUM_MIXED_SYSTEMS=0 -DOMC_NUM_LINEAR_SYSTEMS=0 -DOMC_NUM_NONLINEAR_SYSTEMS=2 -DOMC_NDELAY_EXPRESSIONS=0 -DOMC_NVAR_STRING=0
# define OMC_LDFLAGS_LINK_TYPE env variable to "static" to override this
OMC_LDFLAGS_LINK_TYPE=dynamic
RUNTIME_LIBS= -Wl,--no-as-needed -Wl,--disable-new-dtags -lSimulationRuntimeC -llapack -lblas  -lm -lomcgc -lryu -lpthread -rdynamic -Wl,--no-undefined
LDFLAGS=-L"/usr/bin/../lib/aarch64-linux-gnu/omc" -L"/usr/bin/../lib" -Wl,-rpath,"/usr/bin/../lib/aarch64-linux-gnu/omc"  -Wl,-rpath,"/usr/bin/../lib"   $(RUNTIME_LIBS) 
DIREXTRA=-L"/work/model"
MAINFILE=RideThroughCore.c
MAINOBJ=RideThroughCore.o
CFILES=RideThroughCore_functions.c RideThroughCore_records.c \
RideThroughCore_01exo.c RideThroughCore_02nls.c RideThroughCore_03lsy.c RideThroughCore_04set.c RideThroughCore_05evt.c RideThroughCore_06inz.c RideThroughCore_07dly.c \
RideThroughCore_08bnd.c RideThroughCore_09alg.c RideThroughCore_10asr.c RideThroughCore_11mix.c RideThroughCore_12jac.c RideThroughCore_13opt.c RideThroughCore_14lnz.c \
RideThroughCore_15syn.c RideThroughCore_16dae.c RideThroughCore_17inl.c RideThroughCore_18spd.c 

OFILES=$(CFILES:.c=.o)
GENERATEDFILES=$(MAINFILE) RideThroughCore.makefile RideThroughCore_literals.h RideThroughCore_functions.h $(CFILES)

.PHONY: omc_main_target clean bundle

# This is to make sure that RideThroughCore_*.c are always compiled.
.PHONY: $(CFILES)

omc_main_target: $(MAINOBJ) RideThroughCore_functions.h RideThroughCore_literals.h $(OFILES)
	$(CC) -I. -o RideThroughCore$(EXEEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

omc_dll_target: $(MAINOBJ) RideThroughCore_functions.h RideThroughCore_literals.h $(OFILES)
	$(CC) -DOMC_DLL_MAIN_DEFINE -o $(MAINOBJ) -c $(MAINFILE) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)
	$(CC) -shared -I. -o RideThroughCore$(DLLEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

clean:
	@rm -f RideThroughCore_records.o $(MAINOBJ)

bundle:
	@tar -cvf RideThroughCore_Files.tar $(GENERATEDFILES)